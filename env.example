# Environment Configuration for E-Vehicle Charging Station Management System

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ev_charging_stations

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Server Configuration
PORT=3000
NODE_ENV=development

# Instructions:
# 1. Replace 'your_mysql_password' with your actual MySQL password
# 2. Get Razorpay credentials from https://razorpay.com/
# 3. Get Google Maps API key from https://console.cloud.google.com/
# 4. Copy this file to .env in your project root
# 5. Install dependencies: npm install
# 6. Set up database: mysql -u root -p < database_schema.sql
# 7. Start server: npm start


